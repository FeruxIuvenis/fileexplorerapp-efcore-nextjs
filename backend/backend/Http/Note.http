@baseUrl = http://localhost:5137

### Get all notes
GET {{baseUrl}}/api/notes/
Accept: application/json

### Get a note with by ID
GET {{baseUrl}}/api/notes/1
Accept: application/json

### Create a new note
POST {{baseUrl}}/api/notes/
Content-Type: application/json
Accept: application/json

{
  "title": "How to play Valheim",
  "content": "In this video I will explain to you how to kill the Fader boss",
  "parentId": null
}

### Edit an existing note
PATCH {{baseUrl}}/api/notes/2
Content-Type: application/json
Accept: application/json

{
  "title": "AN EDITED NOTE",
  "content": "AN EDITED CONTENT",
  "parentId": null
}

### Delete an existing note
DELETE {{baseUrl}}/api/notes/1
Content-Type: application/json