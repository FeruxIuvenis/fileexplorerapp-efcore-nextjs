@baseUrl = http://localhost:5137

### ==========================================
### BROWSE
### ==========================================

### Browse root
GET {{baseUrl}}/api/browse/
Accept: application/json

### Browse a folder by slug
# Replace school_work with an existing folder slug
GET {{baseUrl}}/api/browse/school_work
Accept: application/json

### Browse nested folders
GET {{baseUrl}}/api/browse/school_work/math
Accept: application/json

### Browse a nonexistent folder (expect 404)
GET {{baseUrl}}/api/browse/does-not-exist
Accept: application/json

### ==========================================
### CREATE FOLDER
### ==========================================

### Create a folder in the root
POST {{baseUrl}}/api/folders/
Content-Type: application/json
Accept: application/json

{
  "name": "School_Work",
  "parentId": null
}

### Create a subfolder
# Replace 1 with the actual parent folder ID
POST {{baseUrl}}/api/folders/
Content-Type: application/json
Accept: application/json

{
  "name": "Math / Science",
  "parentId": 1
}

### Create a folder with special characters
POST {{baseUrl}}/api/folders/
Content-Type: application/json
Accept: application/json

{
  "name": "C++ & Programming!",
  "parentId": 3
}

### ==========================================
### GET ALL FOLDERS
### ==========================================

GET {{baseUrl}}/api/folders/
Accept: application/json

### ==========================================
### UPDATE FOLDER (PATCH)
### ==========================================

### Rename a folder
# Replace 1 with an existing folder ID
PATCH {{baseUrl}}/api/folders/3
Content-Type: application/json
Accept: application/json

{
  "name": "Updated Folder Name for the second time",
  "parentId": null
}

### Update a nonexistent folder (expect 404)
PATCH {{baseUrl}}/api/folders/999999
Content-Type: application/json
Accept: application/json

{
  "name": "Does Not Exist",
  "parentId": null
}

### ==========================================
### DELETE FOLDER
### ==========================================

### Delete a folder
# Replace 2 with an existing folder ID
DELETE {{baseUrl}}/api/folders/2

### Delete a nonexistent folder (expect 404)
DELETE {{baseUrl}}/api/folders/999999